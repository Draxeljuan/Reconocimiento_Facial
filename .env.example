# Configuración de Base de Datos SQLite (ruta interna en el contenedor backend)
DATABASE_PATH=/app/data/database.db

# Parámetros del Motor de Reconocimiento Facial
FACE_MATCH_THRESHOLD=0.6

# Puertos expuestos en la Red de Área Local (LAN)
BACKEND_PORT=8000
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443

# IP LAN opcional del host (ej. 192.168.1.50) para incluirla en el SAN del certificado SSL autofirmado
LAN_IP=

# Identificadores de usuario para evitar conflictos de permisos en volúmenes
APP_UID=1000
APP_GID=1000
